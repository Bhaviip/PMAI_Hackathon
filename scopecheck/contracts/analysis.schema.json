{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScopeCheckAnalysis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "change_summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "update",
              "question",
              "preserve",
              "unaffected"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "section_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "section_id",
                "quote"
              ]
            }
          },
          "explanation": {
            "type": "string"
          },
          "proposed_revision": {
            "type": "string"
          },
          "protected_constraint_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "id",
          "artifact_id",
          "kind",
          "evidence",
          "explanation",
          "proposed_revision",
          "protected_constraint_ids"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_owner": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "artifact_ids",
          "suggested_owner"
        ]
      }
    }
  },
  "required": [
    "change_summary",
    "findings",
    "open_questions"
  ]
}
