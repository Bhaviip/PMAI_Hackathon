# Optional AI check. Without a key, ScopeCheck still runs the keyword scan and says so.
# Server-only keys: never prefix them with NEXT_PUBLIC_.
# Provider: "anthropic" or "gemini". Unset = anthropic when ANTHROPIC_API_KEY is set, else gemini.
# AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Model timeout in ms (default 45000). Raise it if the provider is congested.
# MODEL_TIMEOUT_MS=45000
